# BioPack AI Environment Configuration
# Optional: Provide an API key for Google Gemini or OpenAI to enable real LLM contextual reasoning.
# If left blank, BioPack AI uses the built-in local semantic NLP matcher (0 cost, offline, 1ms latency).

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=

# LLM Provider selection: "auto", "gemini", "openai", or "local"
LLM_PROVIDER=auto

# Database URL (Defaults to SQLite backend/biopack.db)
DATABASE_URL=sqlite:///backend/biopack.db
